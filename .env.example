# ==============================================================================
# AHSAN AI LABS — Production Environment Configuration Template
# Duplicate this file as .env in production and configure the values below
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=3000

# MongoDB Database Connection (Local Docker or External MongoDB Atlas / Cluster)
# If using the included Docker container, use the pre-configured local connection string:
MONGODB_URI="mongodb://ahsan_admin:AhsanSecureMongoPass2026!@127.0.0.1:27017/AHSAN_AI_LABS?authSource=admin"
DATABASE_NAME="AHSAN_AI_LABS"

# Administrative Security & Credentials
# Note: Always keep passwords with special characters (like &, @, :, !) enclosed in double quotes ("")
ADMIN_SECRET="ahsan_ai_labs_super_secure_jwt_secret_key_2026"
ADMIN_EMAIL="admin@ahsanailabs.com"
ADMIN_PASSWORD="admin_password_123"

# n8n Automation Engine Webhook Configuration
N8N_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/ahsan-ai-inquiry
N8N_WEBHOOK_SECRET=ahsan_n8n_secret_token_2026

# WhatsApp Cloud API & Notifications (Optional Direct Trigger)
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# Outbound Email SMTP Configuration (Optional Direct Trigger)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# Public Platform URL
SITE_URL=https://ahsanailabs.bond
